PORT=3000
HOST=127.0.0.1
# Set both for optional AI ranking. Without them, transparent keyword rules are used.
OPENAI_API_KEY=
OPENAI_MODEL=
# Required for delivery. Use a verified Resend sender domain.
RESEND_API_KEY=
EMAIL_FROM=
# Optional: increases the official GitHub API rate limit.
GITHUB_TOKEN=
# Keep disabled until you have saved your email preferences.
ENABLE_SCHEDULER=false
# Single-user remote deployments require a strong access token and HTTPS proxy.
APP_TOKEN=
